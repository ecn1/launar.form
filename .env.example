# launar.form — environment variables
# Copy this file to .env (local) or set these as panel variables on your host.

# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token — Discord Developer Portal > Your App > Bot > Reset Token
DISCORD_TOKEN=your-bot-token-here

# Application ID — Discord Developer Portal > Your App > General Information
CLIENT_ID=your-application-id-here

# OPTIONAL: a server ID. When set, commands register instantly in that one
# server (instead of taking up to ~1 hour globally). Remove for production.
# GUILD_ID=your-server-id-here

# ── Google (only needed for /createform and /delform) ─────────────────────────
# OPTION A (recommended — works on free Gmail): OAuth as your own account.
# Create an OAuth client (type "Desktop app") in your Google Cloud project,
# put its ID/secret here, then run:  node scripts/authorize.js
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxx
# GOOGLE_OAUTH_REFRESH_TOKEN=   # printed by scripts/authorize.js

# OPTIONAL: organize created forms into a Drive folder (ID or URL):
# GOOGLE_FORMS_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# OPTION B (advanced — Workspace only, see README): service account key.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
#
# /shareform, /formlist and /help work WITHOUT any Google setup.
